{
  "name": "@nexo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed/index.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nexo/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.0.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}