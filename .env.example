# Banco local (docker compose). Em produção, a URL do Postgres no Coolify com ?sslmode=require
DATABASE_URL=postgres://nexo:nexo@localhost:5432/nexo

# Sessão (gere com: openssl rand -base64 32)
SESSION_SECRET=troque-por-um-valor-aleatorio

# URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# LLM (configurado na etapa do agent)
LLM_API_KEY=