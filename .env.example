# Banco local (docker compose). Em produção, a URL do Postgres no Coolify com ?sslmode=require
DATABASE_URL=postgres://nexo:nexo@localhost:5432/nexo

# API
PORT=4000
SESSION_TTL_HOURS=12

# Origens liberadas no CORS, separadas por vírgula
NEXT_PUBLIC_API_URL=http://localhost:4000

# Web
API_URL=http://localhost:4000

# LLM: Gemini via Google AI Studio (free tier)
# Gere a chave em https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Serviço de chamados simulado (sistema legado instável). Taxa 0 desliga.
TICKETS_FAILURE_RATE=0.15
TICKETS_LATENCY_MS=150-600

# Proteção da cota do LLM
RATE_LIMIT_TURNS_PER_MINUTE=6
RATE_LIMIT_TURNS_PER_DAY=60
AGENT_DAILY_LIMIT=300

# Produção
# COOKIE_SECURE=true
# SEED_IF_EMPTY=true